# --- Database ---
DATABASE_URL="postgresql://quoteflow:quoteflow@localhost:5432/quoteflow?schema=public"

# --- Auth.js (NextAuth v5) ---
# Generate with: npx auth secret
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_URL="http://localhost:3000"

# --- Email (Resend) — used for magic-link auth AND transactional email ---
# Leave blank locally: emails will be logged to the console instead of sent.
RESEND_API_KEY=""
EMAIL_FROM="QuoteFlow <noreply@yourdomain.com>"

# --- SMS (Twilio) ---
# Leave blank locally: SMS sends will be logged to the console instead of sent.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# --- AI (Anthropic Claude) ---
# Required for real AI-drafted quotes. Without it, requests still get created
# with a placeholder "please review manually" draft.
ANTHROPIC_API_KEY=""

# --- Payments (Stripe) ---
# Leave blank locally: onboarding skips Checkout and the business stays on its trial.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID=""
STRIPE_PUBLISHABLE_KEY=""

# --- Photo storage (Vercel Blob) ---
# Leave blank locally: photos are written to /public/uploads instead.
BLOB_READ_WRITE_TOKEN=""

# --- Admin access ---
# Comma-separated list of emails allowed to view /admin
ADMIN_EMAILS="fargerod@gmail.com"

# --- Cron ---
# Shared secret checked on /api/cron/follow-up requests
CRON_SECRET="replace-with-a-random-string"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
