generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Auth.js (NextAuth) tables ----------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  accounts Account[]
  sessions Session[]
  business Business?

  @@index([email])
}

// ---------- Core domain ----------

enum Trade {
  PLUMBING
  ELECTRICAL
  HVAC
  HANDYMAN
  LANDSCAPING
  OTHER
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

model Business {
  id     String @id @default(cuid())
  userId String @unique

  name        String
  slug        String @unique
  trade       Trade  @default(PLUMBING)
  serviceArea String?

  /// ISO 3166-1 alpha-2. Drives currency, locale, tax label, phone rules and
  /// language via the registry in src/lib/countries.ts. The rates below are
  /// seeded from that registry at onboarding, then owned by the business.
  country     String  @default("NO") @db.VarChar(2)

  hourlyRate  Decimal @default(1150) @db.Decimal(10, 2)
  calloutFee  Decimal @default(750) @db.Decimal(10, 2)
  /// Tax percentage added on top of ex-tax line items. 0 = not registered, and
  /// is a legitimate, fully-supported value (UK under £90k, US default).
  vatRate     Decimal @default(25) @db.Decimal(5, 2)

  smsTemplateNewQuote     String? @db.Text
  smsTemplateFollowUp     String? @db.Text
  smsTemplateConfirmation String? @db.Text

  ownerPhone       String
  ownerNotifyEmail String?

  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique
  subscriptionStatus   SubscriptionStatus @default(TRIALING)
  trialEndsAt          DateTime
  currentPeriodEnd     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  requests Request[]
  smsLogs  SmsLog[]

  @@index([slug])
}

enum RequestStatus {
  NEW
  QUOTED
  ACCEPTED
  DECLINED
}

model Request {
  id         String        @id @default(cuid())
  businessId String
  status     RequestStatus @default(NEW)

  description     String   @db.Text
  customerName    String
  customerPhone   String
  customerEmail   String?
  customerAddress String
  preferredDates  DateTime[]
  /// Salted hash of the submitter's IP, kept only for rate limiting.
  ipHash          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  photos   Photo[]
  quote    Quote?

  @@index([businessId, status])
  @@index([businessId, createdAt])
}

model Photo {
  id        String   @id @default(cuid())
  requestId String
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

enum QuoteConfidence {
  LOW
  MEDIUM
  HIGH
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
}

model Quote {
  id          String @id @default(cuid())
  requestId   String @unique
  acceptToken String @unique @default(cuid())

  lineItems        Json
  estimatedHours   Decimal         @db.Decimal(6, 2)
  /// Total the customer pays, including tax.
  total            Decimal         @db.Decimal(10, 2)
  /// Tax percentage snapshotted from the business when the quote was drafted.
  vatRate          Decimal         @default(25) @db.Decimal(5, 2)
  /// ISO 4217, snapshotted from the business's country when drafted, so a quote
  /// sent last year still records the currency it was priced in.
  currency         String          @default("NOK") @db.VarChar(3)
  summary          String          @db.Text
  confidence       QuoteConfidence @default(MEDIUM)
  aiRawResponse    Json?
  aiFailedFallback Boolean         @default(false)

  status         QuoteStatus @default(DRAFT)
  sentAt         DateTime?
  respondedAt    DateTime?
  scheduledDate  DateTime?
  followUpSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([status, sentAt])
  @@index([acceptToken])
}

model ErrorLog {
  id        String   @id @default(cuid())
  source    String
  message   String   @db.Text
  meta      Json?
  createdAt DateTime @default(now())

  @@index([source, createdAt])
}

/// One row per outbound SMS, used to enforce the per-business monthly ceiling.
model SmsLog {
  id         String   @id @default(cuid())
  businessId String
  to         String
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
}
